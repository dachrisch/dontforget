DATABASE_URL=mongodb://localhost:27017/dontforget
# Used only by `npm test`. Deliberately a different database than DATABASE_URL —
# tests wipe every collection between cases, and sharing a name with the dev
# DB would delete your local dev data on every test run.
TEST_DATABASE_URL=mongodb://localhost:27017/dontforget-test
PUBLIC_BASE_URL=http://localhost:3000
SEARXNG_BASE_URL=https://search.lehel.xyz
OPENCODE_BASE_URL=https://opencode.lehel.xyz
OPENCODE_API_KEY=changeme
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=dontforget@lehel.xyz