# Docker only runs on the shared servyy-test.lxd host, never locally — see
# .claude/skills/dev-server.md and .claude/skills/test-runner.md. Both
# scripts/spinup_dev_db.sh and scripts/spinup_test_db.sh print the real
# mongodb:// URL (servyy-test's current IP) to export here; these
# placeholders are just illustrative, not a working local default.
#
# Deliberately different databases (not just different env vars) — tests
# wipe every collection between cases (src/testSupport.ts), and sharing a
# database name with dev would delete your dev data on every test run.
DATABASE_URL=mongodb://<servyy-test-ip>:27019/dontforget
TEST_DATABASE_URL=mongodb://<servyy-test-ip>:27018/dontforget-test
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated emails that get the admin role on sign-in (admin UI:
# /api/admin/* stats, user listing, delete user). Empty = no admins.
ADMIN_EMAILS=
# Where the magic-link callback redirects after sign-in. Defaults to
# http://localhost:5173 (Vite) outside production, '/' (same-origin) in
# production — only set this if you're running Vite on a non-default port.
FRONTEND_URL=
# The general-category engines on this instance are SearXNG "private
# engines" (container repo: ansible/plays/templates/searxng/settings.yml.j2)
# — without the matching token every engine is silently skipped and every
# search returns zero results with no error. Same token job-search uses.
# Value: container repo's ansible/plays/vars/secrets.yml, vault_searxng_brave_token
# (google/duckduckgo/brave tokens are all the same value there).
SEARXNG_TOKEN=changeme
SEARXNG_BASE_URL=https://search.lehel.xyz
OPENCODE_BASE_URL=https://opencode.lehel.xyz
OPENCODE_API_KEY=changeme
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=dontforget@lehel.xyz
# Defaults to enabled (runs on every server boot). Set to `false` to stop
# the scheduler from starting locally — otherwise every `tsx watch` restart
# in dev can fire real searxng/opencode calls if the dev DB has a due query.
SCHEDULER_ENABLED=
# Stripe billing (see docs/superpowers/plans/2026-08-18-stripe-billing.md).
# Test-mode keys in dev. STRIPE_PRICE_ID is the graduated tiered monthly
# price: 1 unit free, €0.50 per unit after that.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=